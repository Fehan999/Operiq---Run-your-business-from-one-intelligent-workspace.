# Copy this file to .env.local and fill in the values.

# --- App ---
# Public URL for invite links, canonical URLs and the sitemap. On Vercel it can be left
# empty at first: the app falls back to the deployment's own *.vercel.app domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Pooled connection used by the app at runtime. On Supabase use the transaction pooler (port 6543).
DATABASE_URL=postgresql://operiq:operiq@localhost:5432/operiq
# Connection used by Prisma migrations. On Supabase use the session pooler (port 5432);
# the "direct" connection is IPv6-only on the free plan and unreachable from Vercel.
DIRECT_URL=postgresql://operiq:operiq@localhost:5432/operiq

# --- Firebase Authentication (web app config from the Firebase console) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Supabase Storage (logos, avatars and other images) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. Recommended: lets the server upload without opening the bucket to anonymous writes.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=Operiq

# --- Email (optional, invitations fall back to a copyable link when unset) ---
# Resend only sends from domains you have verified with them (or onboarding@resend.dev for testing).
RESEND_API_KEY=
EMAIL_FROM="Operiq <onboarding@resend.dev>"

# --- Redis (optional, used for rate limiting; falls back to in-memory when unset) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduled jobs ---
# Random string Vercel Cron sends when it calls /api/cron/cleanup. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Author credit (optional, overrides the LinkedIn link built into the app) ---
NEXT_PUBLIC_AUTHOR_LINKEDIN_URL=

# --- Logging ---
LOG_LEVEL=info
